diff -ruN a/apps/readest-app/src/app/reader/components/character/CharacterDialog.tsx readest-main/apps/readest-app/src/app/reader/components/character/CharacterDialog.tsx
--- a/apps/readest-app/src/app/reader/components/character/CharacterDialog.tsx	1970-01-01 00:00:00.000000000 +0000
