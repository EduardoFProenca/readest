+    blocks: [...target.blocks, { id: uniqueId(), type: 'quote', text: quoteText, sourceCfi }],
+    updatedAt: Date.now(),
+    deletedAt: null,
+  };
+  await persist(
+    envConfig,
+    bookKey,
+    all.map((c) => (c.id === characterId ? next : c)),
+  );
+}
