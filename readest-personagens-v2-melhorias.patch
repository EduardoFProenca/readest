+  sourceCfi?: string,
+): Promise<void> {
+  const all = useBookDataStore.getState().getConfig(bookKey)?.characters ?? [];
+  const target = all.find((c) => c.id === characterId);
+  if (!target) return;
+  const next: BookCharacter = {
